  + enviarNotificacion()
}

class Respuesta {
  - id: int
  - texto: String
  - fecha: Date
}

Usuario <|-- Ciudadano
Usuario <|-- Funcionario
Usuario <|-- PersonalDefensoria

Participacion <|-- Denuncia
Participacion <|-- Propuesta

Ciudadano "1" -- "*" Participacion : registra >
Funcionario "1" -- "*" Participacion : atiende >
Participacion "*" -- "1" Categoria : pertenece a >
Participacion "1" -- "*" Notificacion : genera >
Participacion "1" -- "*" Respuesta : tiene >
@enduml







