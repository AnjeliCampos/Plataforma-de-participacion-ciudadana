  + actualizarEstado()
  + registrarRespuesta()
  + clasificarParticipacion()
}

class PersonalDefensoria {
  + supervisarCasos()
}

class Participacion {
  - id: int
  - titulo: String
  - descripcion: String
  - fechaCreacion: Date
  - estado: String
  + cambiarEstado()
  + obtenerDetalle()
}

class Denuncia {
}

class Propuesta {
}

class Categoria {
  - id: int
  - nombre: String
}

class Notificacion {
  - id: int
