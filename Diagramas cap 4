@startuml
actor Ciudadano
participant "Interfaz de la\nPlataforma" as Interfaz
participant "Controlador de\nDenuncias" as Controlador
database "Base de\nDatos" as BD

Ciudadano -> Interfaz : 1. Ingresar datos de denuncia
activate Interfaz

Interfaz -> Controlador : 2. Enviar(datosDenuncia)
activate Controlador

Controlador -> BD : 3. Guardar(datosDenuncia, estado="Registrada")
activate BD

BD --> Controlador : 4. Confirmación de guardado
deactivate BD

Controlador --> Interfaz : 5. Mensaje de éxito

Interfaz --> Ciudadano : 6. Mostrar confirmación de registro
deactivate Interfaz

== Actualización de Estado y Seguimiento ==

note over Controlador : El funcionario municipal \nactualiza el caso en el sistema

Controlador -> BD : 7. ActualizarEstado(nuevoEstado)
activate BD

BD --> Controlador : 8. Confirmación de actualización
deactivate BD

Controlador -> Ciudadano : 9. Enviar notificación(Cambio de estado)
deactivate Controlador
@enduml
